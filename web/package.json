{
  "name": "rireki-tailor",
  "version": "0.5.0",
  "description": "RirekiTailor Web — ATS-tailored CV + cover letter generator, LaTeX→PDF compiled 100% in the browser",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.js",
    "serve": "node scripts/serve.js --port 8080",
    "test": "node scripts/smoke.js",
    "test:e2e": "node scripts/e2e.js",
    "test:all": "npm run test && npm run test:e2e",
    "bootstrap": "node scripts/bootstrap.js",
    "probe": "node scripts/probe.js",
    "verify": "node scripts/verify.js",
    "update:swiftlatex": "node scripts/update-swiftlatex.js"
  },
  "config": {
    "swiftlatex": {
      "version": "v20022022",
      "url": "https://github.com/SwiftLaTeX/SwiftLaTeX/releases/download/v20022022/20-02-2022.zip"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naoeosavio/Rireki-Tailor.git"
  },
  "keywords": [
    "cv",
    "ats",
    "ai",
    "latex",
    "pdftex",
    "swiftlatex",
    "pdf",
    "cover-letter"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/naoeosavio/Rireki-Tailor/issues"
  },
  "homepage": "https://github.com/naoeosavio/Rireki-Tailor#readme",
  "dependencies": {
    "@tell-ai/sdk": "0.2.1"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}